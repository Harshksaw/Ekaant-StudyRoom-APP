model Booking {
  id                Int       @id @default(autoincrement())
  userId            Int
   user       User?    @relation(fields: [userId], references: [id], name: "UserBookings")

  libraryId         Int
library   Library? @relation(fields: [libraryId], references: [id], name: "LibraryBookings")
  initialPrice      Float
  finalPrice        Float
  paid              Boolean   @default(false)
  timeSlotDetails   Json      // Details of the booked time slot
  roomNo            Int
  bookedSeat        Json      // Details of the booked seat
  bookingDate       DateTime
  bookingFinalDate  DateTime?
  friendId  Int?     @unique @default(autoincrement())
  friend    Friend?  @relation(fields: [friendId], references: [id], name: "BookingFriend")
  bookingPeriod     Int       @default(1)
  transactionDetails Json?    // Details of the transaction
  bookingStatus     BookingStatus @default(PENDING)
  approved          Boolean   @default(false)
  timeStamp         DateTime  @default(now())
  invoice   Invoice?
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Friend {
  id          Int     @id @default(autoincrement())
  name        String  
  email       String?
  phoneNumber  String? // Consider using BigInt if you need to store it as a number and perform numeric operations
  relationship String?
  userId      Int?    
  user         User?    @relation(fields: [userId], references: [id])
  booking     Booking? @relation(name: "BookingFriend")
}





model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  review    String   
  stars     Int      
  createdAt DateTime @default(now())
  libraryId Int
  library   Library  @relation(fields: [libraryId], references: [id], name: "Reviews")
}

model Amenities {
  id                Int      @id @default(autoincrement())
  coldWater          Boolean   @default(false)
  wifi              Boolean   @default(false)
  ac                Boolean   @default(false)
  locker            Boolean   @default(false)
  separateWashroom  Boolean   @default(false)
  news              Boolean   @default(false)
  discussionArea    Boolean   @default(false)
  lunchArea          Boolean   @default(false)
  movingChair        Boolean   @default(false)
  floorMat          Boolean   @default(false)
  separateParking    Boolean   @default(false)
  commonParking      Boolean   @default(false)
  libraryId         Int      @unique
  library           Library   @relation(fields: [libraryId], references: [id])
}

