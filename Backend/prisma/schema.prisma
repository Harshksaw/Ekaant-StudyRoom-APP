model PhoneOtp {
  id          Int      @id @default(autoincrement())
  phoneNumber String  
  phoneOtp    String?  @map("phoneotp")
  createdAt   DateTime @default(now()) @db.Timestamp(6)
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String   
  emailOtp  String?  @map("emailotp")
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model Invoice {
  id                  Int       @id @default(autoincrement())
  bookingId           Int       @unique
  invoiceNumber       String    @default("INV-0")
  booking             Booking   @relation(fields: [bookingId], references: [id])
  libraryAddress      String    @map("libraryaddress")
  libraryName         String
  invoiceDate         DateTime  @default(now())
  customerName        String
  customerEmail       String
  customerPhoneNumber String
  libraryId           Int
  library             Library   @relation(fields: [libraryId], references: [id], name: "LibraryInvoices")
  // library             Library   @relation(fields: [libraryId], references: [id])
  initialPrice        Int
  finalPrice          Int
  paid                Boolean
  bookingDate         DateTime
  bookingPeriod       Int
  bookingStatus       String
  approved            Boolean
  timeStamp           DateTime? @db.Timestamp(6)
  bookingFinalDate    DateTime
  seatLabel           String
  timeSlotDetails     Json?
}

model Distance {
  id        Int      @id @default(autoincrement())
  libraryId Int
  library   Library  @relation(fields: [libraryId], references: [id])
  city      String
  distance  Float
}

