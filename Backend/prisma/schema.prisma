generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model App {
  id             Int      @id @default(autoincrement())
  Banner         String[]
  locations     Location[]

}

model Location {
  id            Int     @id @default(autoincrement())
  location      String  
  locationImage String?
  coords        Float[]
  appId         Int   @default(autoincrement())
  app           App     @relation(fields: [appId], references: [id])
}

//Admin
model Admin {
  id                  Int                @id @default(autoincrement())
  username              String    @unique
  email                 String    @unique
  phoneNumber           String    @db.VarChar(10)
  Dob                   DateTime?
  password              String
  accountType           String    @default("Admin")
  fullName              String
  AddharNumber          String
  PanNumber             String
  address               Json
  adhaarCardDetails     AdhaarCardDetails? 
  panCardDetails        PanCardDetails?
  profileImage          String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  ownedProperties       Library[] @relation("OwnedProperties")
  libraryBookings       Library[] @relation("LibraryBookings")
}


model AdhaarCardDetails {
  id             Int     @id @default(autoincrement())
  adhaarNumber   String  
  adhaarCardFile String  
  adminId        Int     @unique
  admin          Admin   @relation(fields: [adminId], references: [id])
}

model PanCardDetails {
  id           Int     @id @default(autoincrement())
  panNumber     String  
  panCardFile   String  
  adminId      Int     @unique
  admin        Admin   @relation(fields: [adminId], references: [id])
}

//Users
model User {
  id                  Int             @id @default(autoincrement())
  username            String          
  email               String          @unique
  phoneNumber         String          @db.VarChar(10)
  password            String          
  accountType         String          
  additionalDetails   String[]
  ownedProperties     Library[]       @relation("OwnedProperties")
  bookings            Booking[] @relation("UserBookings")
  image               String?
  resetPasswordExpires DateTime?
  friends             Friend[]
  timeSlots           TimeSlot[]
  reviews             Review[]
}


model Library {
  id                  Int       @id @default(autoincrement())

  libraryOwnerId      Int?
  libraryOwner        Admin?    @relation(fields: [libraryOwnerId], references: [id], name: "OwnedProperties")
  name                String    
  longDescription     String?
  shortDescription    String    
  thumbnail           String[]
  cardImage           String?
  images              String[]
  location            Json?      
  address             Json?      
  commingSoonMessage  String?   @default("false") // Note: This is a String with default "false" since you have type: String in Mongoose
  rooms               Room[]    @relation("Rooms") 
  coords              String?
  distances Distance[]

  reviews             Review[]  @relation("Reviews")
  deleted             Boolean   @default(false)
  amenities           Amenities? 
  comingSoon          Boolean   @default(false)
  approved            Boolean   @default(false)
  legal               String?
  gstNumber           String?
  gstCertificateFile  String?
  cinNumber           String?
  cinCertificateFile  String?
  tanNumber           String?
  tanCertificateFile  String?
  msmeNumber          String?
  msmeCertificateFile String?

  registrationFees    Int    @default(500)

  users               User[]    @relation("OwnedProperties")
  admins              Admin[]   @relation("LibraryBookings")
  bookings            Booking[] @relation("LibraryBookings")
  invoices            Invoice[] @relation("LibraryInvoices")
}

model Room {
  id        Int      @id @default(autoincrement())
  libraryId Int
  library   Library  @relation(fields: [libraryId], references: [id], name: "Rooms")
  roomNo    Int      
  Ac        Boolean  @default(false)
  seats     Seat[]
  doorPosition Int[] @default(dbgenerated("ARRAY[0, 0, 0, 0, 0]::Int[]"))
}
model Seat {
  id        Int     @id @default(autoincrement())
  seatId    String  
  seatLabel String  
  rotation Int  @default(0)
  roomId    Int
  room      Room    @relation(fields: [roomId], references: [id])
  timeSlots TimeSlot[]
}

model TimeSlot {
  id            Int       @id @default(autoincrement())
  slotId        String    @default(uuid())
  from          String    
  to            String    
  booked        Boolean   @default(false)
  bookedById    Int?
  bookedBy      User?     @relation(fields: [bookedById], references: [id])
  bookingSource String    @default("app")
  price         Int       @default(0)   
  bookingEndDate DateTime?
  seatId        Int
  seat          Seat      @relation(fields: [seatId], references: [id])
}


